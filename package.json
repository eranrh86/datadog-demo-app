{
  "name": "datadog-demo-app",
  "version": "1.0.0",
  "description": "Demo application for Datadog developer features",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "start:demo": "DD_SERVICE=datadog-demo-app DD_ENV=demo DD_VERSION=1.0.0 node --enable-source-maps src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:flaky": "jest --testNamePattern='flaky'",
    "lint": "eslint src/",
    "security-scan": "npm audit && snyk test"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dd-trace": "^5.76.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "lodash": "^4.17.21",
    "mysql2": "^3.6.5",
    "openai": "^4.104.0",
    "redis": "^4.6.10",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "eslint": "^8.55.0",
    "eslint-plugin-security": "^1.7.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "snyk": "^1.1266.0",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "datadog": {
    "service": "datadog-demo-app",
    "env": "demo",
    "version": "1.0.0"
  }
}
